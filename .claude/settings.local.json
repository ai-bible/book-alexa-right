{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(move:*)",
      "Bash(copy:*)",
      "Bash(dir:*)",
      "Bash(tree:*)",
      "Bash(test:*)",
      "Bash(findstr:*)",
      "Bash(chcp:*)",
      "Bash(set:*)",
      "Bash(python:*)",
      "Bash(python -c:*)",
      "Bash(python -m py_compile:*)",
      "Bash(PYTHONUTF8=1 python:*)",
      "Bash(powershell:*)",
      "Bash(git diff:*)",
      "Bash(tasklist:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "WebSearch",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "mcp__workflow_orchestration__validate_prerequisites",
      "mcp__workflow_orchestration__list_workflows",
      "mcp__workflow_orchestration__update_workflow_state",
      "Skill(ai-prose-detector)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "workflow_orchestration"
  ],
  "disabledMcpjsonServers": [
    "ai-book-state-tracker",
    "session_management",
    "hat-thinks"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/agent_call_logger_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/workflow_checkpoint_hook.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "outputStyle": "default"
}
